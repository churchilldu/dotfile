# https://dev.to/brandonwallace/how-to-use-vim-mode-on-the-command-line-in-bash-fnn
set -o vi

alias gs='git status'
alias gd='git diff'
alias gc='git commit'
alias ll='ls -l'
alias la='ls --almost-all -l'

bind 'set show-all-if-ambiguous on'   # show completions on first tab
bind 'set completion-ignore-case on'  # case-insensitive tab completion

# History
HISTIGNORE="ls:cd:pwd:exit:clear"    # skip trivial commands
HISTSIZE=1000                        # lines in memory
HISTFILESIZE=1000                    # lines on disk
# ignoreboth = ignorespace (skip cmds starting with space) + ignoredups (skip consecutive dupes)
# erasedups  = remove older duplicates, keep only the latest entry
export HISTCONTROL=ignoreboth:erasedups
# Append history on exit instead of overwriting (preserves history across multiple terminals)
shopt -s histappend

shopt -s nocaseglob       # case-insensitive globbing


[ -f ~/.fzf.bash ] && source ~/.fzf.bash

export PATH="/c/Users/jesse/scoop/shims:$PATH"
export PATH="/c/Users/jesse/scoop/apps/maven/current/bin:$PATH"

# --- prompt: (branch)dir, sorin-style arrows (see bash/prompt.sh) ---
[ -f ~/.prompt.sh ] && source ~/.prompt.sh

# --- bash-completion scripts: one file per tool, eager load ---
for _comp in ~/.bash_completion.d/*; do
    [ -f "$_comp" ] && source "$_comp"
done
unset _comp
